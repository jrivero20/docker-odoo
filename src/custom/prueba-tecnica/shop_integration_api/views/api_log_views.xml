<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_api_log_tree" model="ir.ui.view">
        <field name="name">shop.api.log.tree</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <tree string="Logs de API" create="false" edit="false" delete="false" decoration-danger="status_code &gt;= 400" decoration-success="status_code &gt;= 200 and status_code &lt; 300">
                <field name="create_date" string="Fecha y Hora"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="duration_ms"/>
                <field name="user_id"/>
                <field name="ip_address"/>
            </tree>
        </field>
    </record>

    <record id="view_shop_api_log_form" model="ir.ui.view">
        <field name="name">shop.api.log.form</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <form string="Registro de Llamada API" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Detalles de la Petición">
                            <field name="create_date" string="Fecha y Hora"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="ip_address"/>
                        </group>
                        <group string="Resultado">
                            <field name="status_code"/>
                            <field name="duration_ms"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload Enviado" name="request_payload">
                            <field name="request_payload" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Respuesta Devuelta" name="response_payload">
                            <field name="response_payload" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Error" name="error_message" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shop_api_log_search" model="ir.ui.view">
        <field name="name">shop.api.log.search</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Logs de API">
                <field name="endpoint"/>
                <field name="user_id"/>
                <field name="status_code"/>
                <filter string="Errores (&gt;= 400)" name="filter_errors" domain="[('status_code', '&gt;=', 400)]"/>
                <filter string="Exitosas (2xx)" name="filter_success" domain="[('status_code', '&gt;=', 200), ('status_code', '&lt;', 300)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter string="Código HTTP" name="group_status" context="{'group_by': 'status_code'}"/>
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shop_api_log" model="ir.actions.act_window">
        <field name="name">Logs de Integración API</field>
        <field name="res_model">shop.api.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_shop_api_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay registros de llamadas API disponibles aún.
            </p>
        </field>
    </record>

    <menuitem id="menu_shop_api_log"
              name="Logs API Tienda"
              parent="sale.menu_sale_config"
              action="action_shop_api_log"
              sequence="90"/>
</odoo>

